    <string name="disconnect_reset_title">Se déconnecter et réinitialiser ?</string>
    <string name="disconnect_reset_message">Actua synchronisera tous les budgets téléchargés depuis le serveur, puis supprimera de cet appareil les budgets téléchargés, les sauvegardes locales, les clés de chiffrement et les données de connexion. Vos budgets sur le serveur Actual ne seront pas supprimés. Les réglages d’affichage de l’appareil et le budget de démonstration local seront conservés.</string>
    <string name="disconnect_reset_action">Se déconnecter et réinitialiser</string>
    <string name="widget_action_cancel">Annuler</string>
    <string name="disconnect_syncing_title">Synchronisation avant la déconnexion</string>
    <string name="disconnect_syncing_message">Enregistrement des dernières modifications Actual et Actua de tous les budgets téléchargés depuis le serveur avant la suppression des données locales.</string>
    <string name="disconnect_sync_failed_title">Impossible de synchroniser les dernières modifications</string>
    <string name="disconnect_sync_failed_message">Actua n’a supprimé aucune donnée budgétaire locale. Si vous vous déconnectez quand même, les modifications qui n’ont pas atteint votre serveur Actual risquent d’être définitivement perdues.</string>
